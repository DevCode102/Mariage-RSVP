# PostgreSQL (Prisma / Neon / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Admin dashboard password
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (use a long random string)
AUTH_SECRET="replace-with-a-long-random-secret"

# Vercel Blob (private store)
BLOB_STORE_ID="store_..."
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Google Gemini (Conseiller de Style AI)
GEMINI_API_KEY="your-gemini-api-key"
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"
